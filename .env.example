# Copy this file to .env (same folder) and fill in the values. The .env file is ignored by git.

# MySQL container
DB_NAME=tingeso1
DB_USER=
DB_PSW=
DB_ROOT_PSW=

# Keycloak: secret of the "siga-backend" client (the backend uses it to create users)
SIGA_BACKEND_CLIENT_SECRET=

# Load the sample careers, study plans and courses of the appendix on the first start (true/false)
SEED_DATA=true
